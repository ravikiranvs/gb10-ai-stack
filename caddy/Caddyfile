{
	auto_https disable_redirects   # the public site is plain http behind Funnel; only the bridge listener below gets a certificate
	admin off
	servers {
		trusted_proxies static 127.0.0.1/32
	}
}

(authelia) {
	forward_auth 127.0.0.1:9091 {
		uri /auth/api/authz/forward-auth
		header_up X-Forwarded-Proto https    # all public traffic arrives over HTTPS (Funnel); Authelia builds its post-login return URL from this
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

(stream) {
	flush_interval -1
	transport http {
		read_timeout 15m
	}
}

http://:9080 {
	bind 127.0.0.1
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Login portal
	handle /auth* {
		reverse_proxy 127.0.0.1:9091
	}

	# Model API: machine clients authenticate with LiteLLM virtual keys
	handle /llm/v1/* {
		request_header -Remote-User
		request_header -Remote-Groups
		request_header -Remote-Email
		request_header -Remote-Name
		reverse_proxy 127.0.0.1:4000 {
			import stream
		}
	}

	# LiteLLM admin UI
	handle /llm* {
		import authelia
		reverse_proxy 127.0.0.1:4000
	}

	# OpenClaw Control UI + WebSocket (gateway.controlUi.basePath = /openclaw)
	handle /openclaw* {
		import authelia
		reverse_proxy 127.0.0.1:18789 {
			import stream
		}
	}

	# Grafana (serve_from_sub_path); signs in through Authelia OIDC, so no forward_auth here
	handle /grafana* {
		reverse_proxy 127.0.0.1:3000
	}

	# ComfyUI (prefix stripped after auth)
	redir /comfy /comfy/
	handle /comfy/* {
		route {
			import authelia
			uri strip_prefix /comfy
			reverse_proxy 127.0.0.1:8188 {
				import stream
			}
		}
	}

	# Brand assets: public so Portainer's custom-logo URL (fetched by the browser) and the login pages can load them
	handle /brand/* {
		uri strip_prefix /brand
		root * /srv/branding
		file_server
	}

	# LiteLLM's UI asks for /get_favicon and /favicon.ico without its /llm prefix (and Portainer asks for /favicon.ico), so serve ours at the root
	@icon path /favicon.ico /get_favicon
	handle @icon {
		rewrite * /favicon.ico
		root * /srv/branding
		file_server
	}

	# Portainer (prefix stripped; Authelia is its OIDC provider, so no forward_auth here)
	redir /portainer /portainer/
	handle /portainer/* {
		uri strip_prefix /portainer
		reverse_proxy 127.0.0.1:9010 {
			import stream
		}
	}

	# One-click sign-in to OpenClaw for any signed-in admin or user (the dashboard hands over the gateway token)
	handle /connect {
		import authelia
		reverse_proxy 127.0.0.1:9000
	}

	# Dashboard / landing page for everyone (prefix stripped after auth; uvicorn --root-path /home)
	redir /home /home/
	redir /admin* /home/ 302     # old address
	handle /home/* {
		route {
			import authelia
			uri strip_prefix /home
			reverse_proxy 127.0.0.1:9000
		}
	}

	handle {
		redir * /home/ 302
	}

	log {
		output stdout
		format json
	}
}

# MCP gateway for the OpenClaw sandbox only: HTTPS on the docker0 address (NemoClaw's managed MCP needs HTTPS and
# rejects host.openshell.internal and the Funnel hostname, which containers cannot reach). Caddy's own CA signs the
# certificate; the sandbox trusts its root via NEMOCLAW_CORPORATE_CA_BUNDLE. Not published through Funnel.
https://172.17.0.1:8443 {
	bind 172.17.0.1
	tls internal

	@mcp path /llm/*/mcp /llm/*/mcp/*
	handle @mcp {
		request_header -Remote-User
		request_header -Remote-Groups
		request_header -Remote-Email
		request_header -Remote-Name
		reverse_proxy 127.0.0.1:4000 {
			import stream
		}
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}

# Server-side OIDC calls from Portainer (token and userinfo). Containers cannot reach the Funnel hostname, and Authelia needs the
# public host in X-Forwarded-* to build its issuer, so this listener adds them and exposes nothing but the OIDC endpoints.
# Plain http on docker0 only; not published through Funnel.
http://172.17.0.1:9081 {
	bind 172.17.0.1
	@oidc path /auth/api/oidc/token /auth/api/oidc/userinfo
	handle @oidc {
		reverse_proxy 127.0.0.1:9091 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {$PUBLIC_HOST}
		}
	}
	handle {
		respond 404
	}
}
