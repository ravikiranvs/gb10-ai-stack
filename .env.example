# Copy to .env and fill in. Contains no secrets: those live in ./secrets/.
# scripts/init-secrets.sh copies this file to .env the first time it runs.

# ---- host ----
PUBLIC_HOST=gb10.example-tailnet.ts.net   # your Tailscale hostname (tailscale status / the Funnel URL), no scheme
# Address the OpenShell sandbox reaches as host.openshell.internal. LiteLLM (:4000) and Alloy OTLP (:4318) publish on it.
#   First bring-up: leave 172.17.0.1 (docker0). NemoClaw creates the sandbox network (openshell-docker) later; then set this to
#   that network's gateway and recreate litellm + alloy:   docker network inspect openshell-docker --format '{{(index .IPAM.Config 0).Gateway}}'
DOCKER_BRIDGE_IP=172.17.0.1
MODELS_DIR=/srv/models
TZ=UTC

# ---- images (arm64 tags that were verified on the GB10) ----
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.09-py3
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.09-py3
LLAMA_SWAP_VERSION=265                # numeric llama-swap release
COMFYUI_REF=v0.42.1                   # ComfyUI git tag or commit
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.2
ALLOY_IMAGE=grafana/alloy:v1.21.0
PROMETHEUS_IMAGE=prom/prometheus:v3.5.5
LOKI_IMAGE=grafana/loki:3.7.9
TEMPO_IMAGE=grafana/tempo:2.10.9
GRAFANA_IMAGE=grafana/grafana:13.2.4
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
CADVISOR_IMAGE=ghcr.io/google/cadvisor:v0.60.6

# ---- behaviour ----
COMFY_IDLE_MINUTES=10
COMFY_DEFAULT_STEPS=4
NEMOCLAW_SANDBOX=nemoclaw-assistant   # sandbox name given to `nemoclaw onboard`; the dashboard finds the container by this name
