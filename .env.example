# Copy to .env and fill in. Contains no secrets — those live in ./secrets/.

# ---- host ----
PUBLIC_HOST=gb10.example-tailnet.ts.net
DOCKER_BRIDGE_IP=172.17.0.1          # ip -4 addr show docker0
DOCKER_GID=999                        # getent group docker | cut -d: -f3
MODELS_DIR=/srv/models
TZ=UTC

# ---- images (pin exact arm64 tags) ----
VLLM_IMAGE=nvcr.io/nvidia/vllm:CHANGE_ME
PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:CHANGE_ME-py3
LLAMA_SWAP_VERSION=CHANGE_ME          # numeric llama-swap release, e.g. 170
COMFYUI_REF=CHANGE_ME                 # ComfyUI git tag or commit
LITELLM_IMAGE=ghcr.io/berriai/litellm:CHANGE_ME
OPENSHELL_GATEWAY_IMAGE=ghcr.io/nvidia/openshell/gateway:CHANGE_ME
ALLOY_IMAGE=grafana/alloy:CHANGE_ME
PROMETHEUS_IMAGE=prom/prometheus:CHANGE_ME
LOKI_IMAGE=grafana/loki:CHANGE_ME
TEMPO_IMAGE=grafana/tempo:CHANGE_ME
GRAFANA_IMAGE=grafana/grafana-oss:CHANGE_ME
NODE_EXPORTER_IMAGE=prom/node-exporter:CHANGE_ME
CADVISOR_IMAGE=gcr.io/cadvisor/cadvisor:CHANGE_ME

# ---- behaviour ----
COMFY_IDLE_MINUTES=10
COMFY_DEFAULT_STEPS=4
NEMOCLAW_SANDBOX=my-assistant
