// Merge into the OpenClaw config inside the NemoClaw sandbox.
// Replace gb10.example-tailnet.ts.net with your PUBLIC_HOST.
{
  gateway: {
    bind: "loopback",
    port: 18789,
    publicOrigin: "https://gb10.example-tailnet.ts.net",
    controlUi: { enabled: true, basePath: "/openclaw" },
    trustedProxies: ["127.0.0.1"],
    auth: {
      mode: "trusted-proxy",
      trustedProxy: {
        userHeader: "remote-email",
        allowLoopback: true,
      },
      rateLimit: { maxAttempts: 10, windowMs: 60000, lockoutMs: 300000 },
    },
    tailscale: { mode: "off" },
  },

  agents: {
    defaults: {
      model: { primary: "agent" },
      imageModel: { primary: "qwen3-vl-30b" },
    },
  },

  plugins: {
    allow: ["diagnostics-otel"],
    entries: { "diagnostics-otel": { enabled: true } },
  },

  diagnostics: {
    enabled: true,
    otel: {
      enabled: true,
      endpoint: "http://host.openshell.internal:4318",
      protocol: "http/protobuf",
      serviceName: "openclaw-gateway",
      traces: true,
      metrics: true,
      logs: true,
      sampleRate: 1.0,
      flushIntervalMs: 15000,
    },
  },
}
