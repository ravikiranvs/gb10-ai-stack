{
  "uid": "gb10-overview",
  "title": "GB10 · AI Stack Overview",
  "tags": ["gb10", "ai-stack"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "row", "title": "Host · GB10", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2, "type": "gauge", "title": "Unified memory used",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 } ] } } },
      "targets": [{ "refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)" }]
    },
    {
      "id": 3, "type": "gauge", "title": "GPU utilisation",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{ "refId": "A", "expr": "gb10_gpu_utilization_percent" }]
    },
    {
      "id": 4, "type": "stat", "title": "GPU temperature",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "celsius",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 85 } ] } } },
      "targets": [{ "refId": "A", "expr": "gb10_gpu_temperature_celsius" }]
    },
    {
      "id": 5, "type": "stat", "title": "GPU power",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "watt" } },
      "targets": [{ "refId": "A", "expr": "gb10_gpu_power_watts" }]
    },
    {
      "id": 6, "type": "stat", "title": "GPU collector age",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 60 } ] } } },
      "targets": [{ "refId": "A", "expr": "time() - gb10_gpu_collector_timestamp_seconds" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Memory available / swap free",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "MemAvailable" },
        { "refId": "B", "expr": "node_memory_SwapFree_bytes", "legendFormat": "SwapFree" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Container memory (top 10)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [{ "refId": "A",
        "expr": "topk(10, container_memory_working_set_bytes{name!=\"\"})",
        "legendFormat": "{{name}}" }]
    },
    {
      "id": 9, "type": "row", "title": "Models", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 10, "type": "state-timeline", "title": "Model up (scale-to-zero)",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "stopped", "color": "#6b7280" }, "1": { "text": "up", "color": "green" } } }] } },
      "targets": [{ "refId": "A", "expr": "up{job=~\"vllm-.*\"}", "legendFormat": "{{model}}" }]
    },
    {
      "id": 11, "type": "timeseries", "title": "vLLM requests running / waiting",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "vllm:num_requests_running", "legendFormat": "running · {{model_name}}" },
        { "refId": "B", "expr": "vllm:num_requests_waiting", "legendFormat": "waiting · {{model_name}}" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "vLLM time to first token (p95)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [{ "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
        "legendFormat": "{{model_name}}" }]
    },
    {
      "id": 13, "type": "timeseries", "title": "vLLM generation tokens/s",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[1m]))",
        "legendFormat": "{{model_name}}" }]
    },
    {
      "id": 14, "type": "row", "title": "Gateway · LiteLLM", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }
    },
    {
      "id": 15, "type": "timeseries", "title": "Requests / s by key",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "sum by (api_key_alias) (rate(litellm_proxy_total_requests_metric_total[5m]))",
        "legendFormat": "{{api_key_alias}}" }]
    },
    {
      "id": 16, "type": "timeseries", "title": "Failed requests / s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A",
        "expr": "sum by (api_key_alias) (rate(litellm_proxy_failed_requests_metric_total[5m]))",
        "legendFormat": "{{api_key_alias}}" }]
    }
  ]
}
