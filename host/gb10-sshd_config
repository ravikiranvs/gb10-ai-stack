# Dedicated sshd for the browser terminal; host/setup.sh installs this file as /etc/ssh/gb10/sshd_config. Port 2222; the admin's own sshd on 22 is untouched.
# Passwords stay off even with PAM: only certificates signed by the CA in ca.pub are accepted, and the certificate's name must be the account name.
Port 2222
ListenAddress 172.17.0.1                 # docker0 gateway: reachable by containers on this machine, not from the LAN or the internet
HostKey /etc/ssh/gb10/ssh_host_ed25519_key
TrustedUserCAKeys /etc/ssh/gb10/ca.pub
PidFile /run/gb10-sshd.pid

AllowGroups gb10-users
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM yes                                           # needed so each login gets a systemd user session: that is what applies the per-user limits (user-<uid>.slice)
AuthenticationMethods publickey

AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
PermitUserRC no

MaxAuthTries 2
LoginGraceTime 20
MaxSessions 4
MaxStartups 10:30:30
ClientAliveInterval 60
ClientAliveCountMax 3
LogLevel VERBOSE
